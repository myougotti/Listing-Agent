# Copy to .env and fill in. Never commit .env.

# RapidAPI key for the zillow-com1 endpoint.
# Sign up at https://rapidapi.com and subscribe to "Zillow.com" (apimaker).
# Free tier exists. Note the monthly quota.
RAPIDAPI_KEY=

# Anthropic API key for the reasoner.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Discord incoming webhook URL. Optional; pipeline runs without it.
# Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=

# Optional: relocate the SQLite database outside the OneDrive-synced folder
# to avoid file-locking conflicts. Absolute path.
# Example: C:\Users\Asmyou\AppData\Local\listing-agent\seen.db
LISTING_AGENT_DB_PATH=

# Optional: path to criteria file. Defaults to ./criteria.yaml.
LISTING_AGENT_CRITERIA=

# Optional: cap total Claude API calls per run to bound spend.
LISTING_AGENT_MAX_REASONER_CALLS=25
